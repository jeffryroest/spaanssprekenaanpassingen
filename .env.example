APP_NAME="Spaansspreken.nl"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spaansspreken
DB_USERNAME=spaansspreken
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@spaansspreken.nl"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Spraaktranscriptie. Bewaar de sleutel uitsluitend als servervariabele in Ploi.
TRANSCRIPTION_DRIVER=openai
TRANSCRIPTION_LOW_CONFIDENCE_THRESHOLD=0.65
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_CONNECT_TIMEOUT=5
OPENAI_TRANSCRIPTION_TIMEOUT=20

# Persoonlijke beurtfeedback op het transcript. Dezelfde serversleutel wordt hergebruikt.
OPENAI_FEEDBACK_MODEL=gpt-4o-mini
OPENAI_FEEDBACK_TIMEOUT=15
FEEDBACK_ASSESSOR_VERSION=turn-rubric-v1
FEEDBACK_FORMATTER_VERSION=layered-feedback-v1

# Alleen aanpassen na een expliciet productbesluit over betaalachterstand.
SUBSCRIPTION_PAST_DUE_GRACE_DAYS=0
